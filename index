   <div class=\"modal-grid\">\n      <aside class=\"modal-aside\">\n        <div class=\"step\">Запись · 30 мая 2026<\u002Fdiv>\n        <h2 id=\"regTitle\" style=\"font-family:\" manrope\",=\"\" sans-serif;font-weight:500;font-size:34px;line-height:1.05;margin:14px=\"\" 0=\"\" 14px;letter-spacing:-.2px;\"=\"\">\n          Несколько <em style=\"font-style:italic;color:var(--gold-soft);font-weight:400;\">данных<\u002Fem> — и место за вами.\n        <\u002Fh2>\n        <p class=\"modal-lead\">Заполните форму — мы свяжемся в течение часа в рабочее время, подтвердим бронь и пришлём реквизиты для оплаты.<\u002Fp>\n        <div class=\"modal-summary\">\n          <div><div class=\"lbl\">Дата<\u002Fdiv><div class=\"vv\">30 мая<\u002Fdiv><\u002Fdiv>\n          <div><div class=\"lbl\">Формат<\u002Fdiv><div class=\"vv\">Лекция · 3 ч<\u002Fdiv><\u002Fdiv>\n          <div><div class=\"lbl\">Место<\u002Fdiv><div class=\"vv\">Москва<\u002Fdiv><\u002Fdiv>\n          <div><div class=\"lbl\">Мест всего<\u002Fdiv><div class=\"vv\"><em>15<\u002Fem><\u002Fdiv><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Faside>\n      <section class=\"modal-form\">\n        <div id=\"formPanel\">\n          <div class=\"ticket-pick\">\n            <label class=\"ticket-opt\" data-ticket=\"standard\">\n              <input type=\"radio\" name=\"ticket\" value=\"standard\" checked=\"\">\n              <div class=\"t-name\">Стандарт<\u002Fdiv>\n              <div class=\"t-price\">15 000 ₽<\u002Fdiv>\n              <div class=\"t-desc\">Лекция, 3 часа · материалы · запись<\u002Fdiv>\n            <\u002Flabel>\n            <label class=\"ticket-opt\" data-ticket=\"premium\">\n              <input type=\"radio\" name=\"ticket\" value=\"premium\">\n              <div class=\"t-name\">Премиум · 5 мест<\u002Fdiv>\n              <div class=\"t-price\">20 000 ₽<\u002Fdiv>\n              <div class=\"t-desc\">Всё из «Стандарта» + консультация до 20 мин<\u002Fdiv>\n            <\u002Flabel>\n          <\u002Fdiv>\n          <form id=\"regForm\" novalidate=\"\">\n            <div class=\"field\">\n              <label for=\"f-name\">Имя<\u002Flabel>\n              <input id=\"f-name\" name=\"name\" type=\"text\" placeholder=\"Как к вам обращаться\" required=\"\">\n            <\u002Fdiv>\n            <div class=\"row2\">\n              <div class=\"field\">\n                <label for=\"f-phone\">Телефон<\u002Flabel>\n                <input id=\"f-phone\" name=\"phone\" type=\"tel\" placeholder=\"+7 (___) ___-__-__\" required=\"\">\n              <\u002Fdiv>\n              <div class=\"field\">\n                <label for=\"f-email\">Email<\u002Flabel>\n                <input id=\"f-email\" name=\"email\" type=\"email\" placeholder=\"you@example.com\" required=\"\">\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div class=\"field\">\n              <label for=\"f-tg\">Telegram<\u002Flabel>\n              <input id=\"f-tg\" name=\"telegram\" type=\"text\" placeholder=\"@username\">\n            <\u002Fdiv>\n            <label class=\"check\">\n              <input id=\"f-agree\" type=\"checkbox\" required=\"\">\n              <span>Согласен на обработку персональных данных и ознакомлен с <a href=\"#\">офертой<\u002Fa> и <a href=\"#\">политикой конфиденциальности<\u002Fa>.<\u002Fspan>\n            <\u002Flabel>\n            <div class=\"total\">\n              <div>\n                <div class=\"lbl\">К оплате<\u002Fdiv>\n                <div class=\"small\" id=\"ticketLabel\">Стандартный билет<\u002Fdiv>\n              <\u002Fdiv>\n              <div class=\"num\" id=\"totalSum\"><em>15 000<\u002Fem> ₽<\u002Fdiv>\n            <\u002Fdiv>\n            <button type=\"submit\" class=\"submit\">Отправить заявку <span class=\"arr\">→<\u002Fspan><\u002Fbutton>\n          <\u002Fform>\n        <\u002Fdiv>\n        <div class=\"success\" id=\"successPanel\">\n          <div class=\"ok\">✓<\u002Fdiv>\n          <h3>Заявка отправлена<\u002Fh3>\n          <p>Спасибо! Свяжемся с вами в Telegram или по телефону в течение часа.<\u002Fp>\n          <button class=\"back-btn\" data-close-register=\"\">← Закрыть<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fsection>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<style>\n  .modal{ position:fixed; inset:0; z-index:100; display:none; }\n  .modal.is-on{ display:block;}\n  .modal-backdrop{ position:absolute; inset:0; background:rgba(8,9,8,.78); backdrop-filter:blur(4px);}\n  .modal-card{\n    position:absolute; inset: 4vh 4vw; max-width:1100px; margin:0 auto;\n    background: var(--bg); border:1px solid var(--rule);\n    overflow:auto; box-shadow: 0 30px 80px rgba(0,0,0,.6);\n    animation: modalIn .35s ease-out;\n  }\n  @keyframes modalIn{ from{opacity:0; transform: translateY(20px);} to{opacity:1;}}\n  .modal-close{\n    position:absolute; top:14px; right:18px; z-index:2;\n    background:transparent; border:none; color:var(--ink-dim);\n    font-size:32px; cursor:pointer; line-height:1; font-family:\"Manrope\", sans-serif;\n    transition: color .2s ease;\n  }\n  .modal-close:hover{ color: var(--gold);}\n  .modal-grid{ display:grid; grid-template-columns: 1fr 1.2fr; min-height: 100%;}\n  .modal-aside{\n    padding: 48px 44px; background: var(--bg-2); border-right:1px solid var(--rule);\n    position:relative; overflow:hidden;\n  }\n  .modal-aside::before{\n    content:\"\"; position:absolute; inset:0; pointer-events:none;\n    background: radial-gradient(60% 60% at 30% 20%, var(--wine-glow), transparent 70%);\n  }\n  .modal-aside > *{ position:relative;}\n  .modal-aside .step{\n    font-size:11px; letter-spacing:.32em; text-transform:uppercase; color:var(--gold-soft);\n    display:inline-flex; align-items:center; gap:10px;\n  }\n  .modal-aside .step::before{ content:\"\"; width:24px; height:1px; background:var(--gold);}\n  .modal-lead{ font-size:14.5px; line-height:1.6; color:var(--ink-dim); max-width:380px;}\n  .modal-summary{\n    margin-top:36px; padding-top:24px; border-top:1px solid var(--rule);\n    display:grid; grid-template-columns: 1fr 1fr; gap:18px 28px;\n  }\n  .modal-summary .lbl{ font-size:10px; letter-spacing:.26em; text-transform:uppercase; color:var(--ink-mute);}\n  .modal-summary .vv{ margin-top:4px; font-family:\"Manrope\", sans-serif; font-size:20px; color:var(--ink);}\n  .modal-summary .vv em{ font-style:normal; color:var(--gold-soft);}\n  .modal-form{ padding: 48px 44px;}\n  .ticket-pick{ display:grid; grid-template-columns:1fr 1fr; gap:12px;}\n  .ticket-opt{\n    border:1px solid var(--rule); padding:16px 16px 18px; cursor:pointer;\n    background:rgba(243,236,216,.02); position:relative;\n    transition: border-color .25s, background .25s;\n  }\n  .ticket-opt input{ position:absolute; opacity:0; pointer-events:none;}\n  .ticket-opt .t-name{ font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:var(--ink-mute);}\n  .ticket-opt .t-price{ margin-top:6px; font-family:\"Manrope\", sans-serif; font-size:24px; color:var(--ink);}\n  .ticket-opt .t-desc{ margin-top:4px; font-size:11.5px; color:var(--ink-mute); line-height:1.45;}\n  .ticket-opt:hover{ border-color:var(--gold);}\n  .ticket-opt.is-selected{ border-color:var(--gold); background:rgba(201,161,74,.05);}\n  .ticket-opt[data-ticket=\"premium\"] .t-name{ color:var(--wine-soft);}\n  .ticket-opt[data-ticket=\"premium\"].is-selected{ border-color:var(--wine-soft); background:linear-gradient(180deg, rgba(122,45,51,.16), rgba(122,45,51,.02));}\n  #regForm{ margin-top:24px; display:flex; flex-direction:column; gap:18px;}\n  #regForm .field{ display:flex; flex-direction:column; gap:6px;}\n  #regForm label{ font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:var(--ink-mute);}\n  #regForm input[type=text],#regForm input[type=tel],#regForm input[type=email]{\n    background:transparent; border:none; border-bottom:1px solid var(--rule);\n    color:var(--ink); font-family:\"DM Sans\", sans-serif; font-weight:300; font-size:15px;\n    padding:8px 0; transition:border-color .2s;\n  }\n  #regForm input:focus{ outline:none; border-bottom-color: var(--gold);}\n  #regForm .row2{ display:grid; grid-template-columns:1fr 1fr; gap:18px;}\n  #regForm .check{ display:flex; gap:10px; align-items:flex-start; font-size:12px; color:var(--ink-dim); line-height:1.5;}\n  #regForm .check input{ margin-top:3px; accent-color:var(--gold);}\n  #regForm .check a{ color:var(--gold-soft); text-decoration:underline; text-decoration-color:rgba(229,201,138,.4);}\n  #regForm .total{\n    padding:16px 0; border-top:1px solid var(--rule); border-bottom:1px solid var(--rule);\n    display:flex; justify-content:space-between; align-items:baseline;\n  }\n  #regForm .total .lbl{ font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:var(--ink-mute);}\n  #regForm .total .small{ font-size:11.5px; color:var(--ink-mute); margin-top:3px;}\n  #regForm .total .num{ font-family:\"Manrope\", sans-serif; font-size:30px; color:var(--ink);}\n  #regForm .total .num em{ font-style:normal; color:var(--gold-soft); font-weight:500;}\n  #regForm .submit{\n    display:inline-flex; align-items:center; justify-content:center; gap:12px;\n    background:var(--gold); color:#1a1408; border:none; cursor:pointer;\n    font-family:\"DM Sans\", sans-serif; font-size:14.5px; font-weight:500; letter-spacing:.04em;\n    padding:16px 28px; transition: background .25s, transform .25s;\n    box-shadow: 0 8px 24px rgba(201,161,74,.18);\n  }\n  #regForm .submit:hover{ background:var(--gold-soft); transform:translateY(-1px);}\n  #regForm .submit .arr{ transition: transform .25s;}\n  #regForm .submit:hover .arr{ transform: translateX(4px);}\n  .success{ display:none; padding: 60px 20px; text-align:center; flex-direction:column; align-items:center;}\n  .success.is-on{ display:flex;}\n  .success .ok{\n    width:56px; height:56px; border:1px solid var(--gold); border-radius:50%;\n    display:flex; align-items:center; justify-content:center; color:var(--gold);\n    font-family:\"Manrope\", sans-serif; font-size:28px; margin-bottom:18px;\n  }\n  .success h3{ font-family:\"Manrope\", sans-serif; font-weight:500; font-size:28px; margin:0 0 10px;}\n  .success p{ color:var(--ink-dim); max-width:340px; line-height:1.6; margin:0;}\n  .back-btn{\n    margin-top:24px; background:transparent; border:1px solid var(--rule); color:var(--ink-dim);\n    padding:12px 22px; cursor:pointer; font-family:\"DM Sans\", sans-serif; font-size:13px;\n    transition: border-color .2s, color .2s;\n  }\n  .back-btn:hover{ border-color:var(--gold); color:var(--gold);}\n  body.modal-open{ overflow:hidden;}\n  @media (max-width: 900px){\n    .modal-card{ inset:0; max-width:none;}\n    .modal-grid{ grid-template-columns: 1fr;}\n    .modal-aside{ padding: 32px 24px; border-right:none; border-bottom:1px solid var(--rule);}\n    .modal-form{ padding: 28px 24px 56px;}\n    .ticket-pick{ grid-template-columns: 1fr;}\n    #regForm .row2{ grid-template-columns: 1fr;}\n    #regForm .submit{ width:100%;}\n  }\n<\u002Fstyle>\n\n<script>\n  const modal = document.getElementById('regModal');\n  const totalEl = document.getElementById('totalSum');\n  const labelEl = document.getElementById('ticketLabel');\n  const opts = document.querySelectorAll('.ticket-opt');\n\n  function setTicket(kind){\n    opts.forEach(o => o.classList.toggle('is-selected', o.dataset.ticket === kind));\n    const input = document.querySelector('.ticket-opt input[value=\"'+kind+'\"]');\n    if(input) input.checked = true;\n    if(kind === 'premium'){\n      totalEl.innerHTML = '<em>20 000<\u002Fem> ₽';\n      labelEl.textContent = 'Премиум · с консультацией 20 мин';\n    } else {\n      totalEl.innerHTML = '<em>15 000<\u002Fem> ₽';\n      labelEl.textContent = 'Стандартный билет';\n    }\n  }\n  setTicket('standard');\n  opts.forEach(o => o.addEventListener('click', () => setTicket(o.dataset.ticket)));\n\n  function openModal(kind){\n    setTicket(kind || 'standard');\n    document.getElementById('formPanel').style.display = '';\n    document.getElementById('successPanel').classList.remove('is-on');\n    modal.classList.add('is-on');\n    document.body.classList.add('modal-open');\n  }\n  function closeModal(){\n    modal.classList.remove('is-on');\n    document.body.classList.remove('modal-open');\n  }\n\n  document.querySelectorAll('[data-open-register]').forEach(el => {\n    el.addEventListener('click', (e) => {\n      e.preventDefault();\n      openModal(el.dataset.openRegister);\n    });\n  });\n  document.querySelectorAll('[data-close-register]').forEach(el => {\n    el.addEventListener('click', closeModal);\n  });\n  document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeModal(); });\n\n  document.getElementById('regForm').addEventListener('submit', (e) => {\n    e.preventDefault();\n    const f = e.target;\n    if(!f.name.value.trim() || !f.phone.value.trim() || !f.email.value.trim() || !document.getElementById('f-agree').checked){\n      alert('Пожалуйста, заполните обязательные поля и подтвердите согласие.');\n      return;\n    }\n    document.getElementById('formPanel').style.display = 'none';\n    document.getElementById('successPanel').classList.add('is-on');\n  });\n<\u002Fscript>\n\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
