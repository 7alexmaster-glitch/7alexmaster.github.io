content:\"\"; position:absolute; inset:0; z-index:1; pointer-events:none;\n    background:\n      radial-gradient(120% 80% at 70% 20%, rgba(10,12,10,0) 0%, rgba(10,12,10,.55) 55%, rgba(10,12,10,.95) 100%),\n      linear-gradient(180deg, rgba(10,12,10,.85) 0%, rgba(10,12,10,.35) 35%, rgba(10,12,10,.55) 70%, rgba(10,12,10,.95) 100%);\n  }\n  /* subtle vignette grain */\n  .hero::after{\n    content:\"\"; position:absolute; inset:0; z-index:1; pointer-events:none; opacity:.08;\n    background-image: radial-gradient(rgba(255,255,255,.5) 1px, transparent 1px);\n    background-size: 3px 3px;\n    mix-blend-mode: overlay;\n  }\n  .hero-inner{\n    position:relative; z-index:2;\n    flex:1; display:flex; flex-direction:column;\n    padding: 28px 64px 56px;\n    max-width:1440px; margin:0 auto; width:100%;\n  }\n  /* topnav */\n  .topnav{\n    display:flex; align-items:center; justify-content:space-between;\n    padding-bottom:36px;\n    border-bottom:1px solid var(--rule);\n    opacity:0; animation: fadeUp 700ms ease-out 100ms forwards;\n  }\n  .brand{\n    font-family:\"Manrope\", sans-serif; font-weight:500;\n    font-size:22px; letter-spacing:.5px;\n  }\n  .brand .dot{ color:var(--gold); margin: 0 6px;}\n  .topnav .meta{\n    font-size:12px; letter-spacing:.18em; text-transform:uppercase;\n    color: var(--ink-dim);\n  }\n  .topnav .meta b{ color:var(--ink); font-weight:500;}\n\n  /* hero body */\n  .hero-body{\n    flex:1; display:grid; grid-template-columns: 1fr; align-content:center;\n    padding-top: clamp(40px, 8vh, 96px);\n    max-width: 880px;\n  }\n\n  .eyebrow{\n    display:inline-flex; align-items:center; gap:10px;\n    font-size:11px; letter-spacing:.32em; text-transform:uppercase;\n    color: var(--gold-soft);\n    opacity:0; animation: fadeUp 700ms ease-out 200ms forwards;\n  }\n  .eyebrow::before{\n    content:\"\"; width:28px; height:1px; background:var(--gold); display:inline-block;\n  }\n  h1.hero-title{\n    font-family:\"Manrope\", sans-serif;\n    font-weight: 500;\n    font-size: clamp(44px, 6.4vw, 92px);\n    line-height: 1.02;\n    letter-spacing: -.5px;\n    margin: 18px 0 0;\n    color: var(--ink);\n    opacity:0; animation: fadeUp 800ms ease-out 300ms forwards;\n    text-wrap: balance;\n  }\n  h1.hero-title em{\n    font-style: italic;\n    color: var(--gold-soft);\n    font-weight:400;\n  }\n  .hero-sub{\n    margin-top: 22px;\n    font-size: clamp(15px, 1.25vw, 18px);\n    line-height: 1.55;\n    color: var(--ink-dim);\n    max-width: 600px;\n    opacity:0; animation: fadeUp 800ms ease-out 400ms forwards;\n  }\n  .hero-cta-row{\n    margin-top: 36px;\n    display:flex; gap:16px; align-items:center; flex-wrap:wrap;\n    opacity:0; animation: fadeUp 800ms ease-out 500ms forwards;\n  }\n  .btn-primary{\n    display:inline-flex; align-items:center; gap:14px;\n    background: var(--gold); color:#1a1408;\n    font-family:\"DM Sans\", sans-serif; font-size: 15px; font-weight: 500;\n    letter-spacing: .04em;\n    padding: 18px 32px;\n    border:none; cursor:pointer;\n    transition: background .25s ease, transform .25s ease, box-shadow .25s ease;\n    text-decoration:none;\n    box-shadow: 0 8px 24px rgba(201,161,74,.18);\n  }\n  .btn-primary:hover{\n    background: var(--gold-soft);\n    transform: translateY(-1px);\n    box-shadow: 0 12px 32px rgba(201,161,74,.28);\n  }\n  .btn-primary .arr{ font-size:18px; line-height:1; transition: transform .25s ease;}\n  .btn-primary:hover .arr{ transform: translateX(4px);}\n  .seats{\n    font-size: 13px; color: var(--ink-mute); letter-spacing:.04em;\n  }\n  .seats b{ color: var(--gold-soft); font-weight:500;}\n\n  /* USP row */\n  .usp{\n    margin-top: clamp(48px, 8vh, 88px);\n    padding-top: 24px;\n    border-top: 1px solid var(--rule);\n    display:grid; grid-template-columns: repeat(4, 1fr);\n    gap: 28px;\n    opacity:0; animation: fadeUp 800ms ease-out 700ms forwards;\n  }\n  .usp-item{ display:flex; flex-direction:column; gap:6px; }\n  .usp-item .k{\n    font-family:\"Manrope\", sans-serif; font-size: 22px; font-weight: 500;\n    color: var(--ink);\n    letter-spacing: .2px;\n  }\n  .usp-item .v{\n    font-size: 12px; color: var(--ink-mute); line-height:1.5;\n    letter-spacing: .02em;\n  }\n\n  @keyframes fadeUp{\n    from{ opacity:0; transform: translateY(14px);}\n    to{ opacity:1; transform: none;}\n  }\n\n  /* scroll cue */\n  .scroll-cue{\n    position:absolute; bottom:24px; left:50%; transform: translateX(-50%);\n    z-index:3; font-size:10px; letter-spacing:.32em; text-transform:uppercase;\n    color: var(--ink-mute);\n    display:flex; flex-direction:column; align-items:center; gap:8px;\n    opacity:0; animation: fadeUp 700ms ease-out 1100ms forwards;\n  }\n  .scroll-cue .line{ width:1px; height:32px; background:var(--ink-mute); animation: scrollLine 2.4s ease-in-out infinite;}\n  @keyframes scrollLine{\n    0%{ transform: scaleY(0); transform-origin: top;}\n    50%{ transform: scaleY(1); transform-origin: top;}\n    51%{ transform-origin: bottom;}\n    100%{ transform: scaleY(0); transform-origin: bottom;}\n  }\n\n  /* ============ PAIN ============ */\n  .pain{\n    background: var(--bg);\n    padding: clamp(80px, 14vh, 160px) 64px;\n    border-top:1px solid var(--rule);\n  }\n  .container{ max-width: 1200px; margin: 0 auto;}\n  .section-eyebrow{\n    font-size:11px; letter-spacing:.32em; text-transform:uppercase;\n    color: var(--gold-soft);\n    display:inline-flex; align-items:center; gap:10px;\n  }\n  .section-eyebrow::before{\n    content:\"\"; width:28px; height:1px; background:var(--gold); display:inline-block;\n  }\n  .section-title{\n    font-family:\"Manrope\", sans-serif;\n    font-weight: 500;\n    font-size: clamp(34px, 4.4vw, 60px);\n    line-height: 1.05;\n    letter-spacing: -.3px;\n    margin: 18px 0 0;\n    max-width: 880px;\n    text-wrap: balance;\n  }\n  .section-title em{ font-style: italic; color: var(--gold-soft); font-weight:400;}\n\n  .pain-grid{\n    margin-top: 56px;\n    display:grid; grid-template-columns: repeat(3, 1fr);\n    gap: 1px;\n    background: var(--rule);\n    border: 1px solid var(--rule);\n  }\n  .pain-card{\n    background: var(--bg);\n    padding: 36px 32px 40px;\n    transition: background .35s ease;\n    position:relative;\n  }\n  .pain-card:hover{ background: var(--bg-2); }\n  .pain-card .num{\n    font-family:\"Manrope\", sans-serif;\n    font-size: 14px; font-weight:500;\n    color: var(--gold);\n    letter-spacing: .12em;\n  }\n  .pain-card h3{\n    margin: 14px 0 14px;\n    font-family:\"Manrope\", sans-serif;\n    font-weight: 500;\n    font-size: 26px;\n    line-height: 1.15;\n    color: var(--ink);\n  }\n  .pain-card p{\n    margin: 0;\n    font-size: 14.5px;\n    line-height: 1.6;\n    color: var(--ink-dim);\n  }\n  .pain-quote{\n    margin-top: 56px;\n    font-family:\"Manrope\", sans-serif;\n    font-style: italic;\n    font-size: clamp(20px, 2vw, 28px);\n    line-height: 1.4;\n    color: var(--ink);\n    max-width: 900px;\n    padding-left: 24px;\n    border-left: 2px solid var(--gold);\n  }\n  .pain-quote span{\n    display:block; margin-top:14px; font-style:normal;\n    font-family:\"DM Sans\", sans-serif; font-size: 12px;\n    color: var(--ink-mute); letter-spacing: .12em; text-transform: uppercase;\n  }\n\n  /* ============ TOPICS (about) ============ */\n  .topics-grid{\n    margin-top: 64px;\n    display:grid; grid-template-columns: repeat(3, 1fr);\n    border: 1px solid var(--rule);\n  }\n  .topic-card{\n    padding: 44px 36px 48px;\n    border-right: 1px solid var(--rule);\n    background: var(--bg);\n    position: relative;\n    transition: background .35s ease;\n  }\n  .topic-card:last-child{ border-right: none;}\n  .topic-card:hover{ background: var(--bg-2);}\n  .topic-num{\n    font-family:\"Manrope\", sans-serif;\n    font-size: 56px; font-weight: 400; line-height: 1;\n    color: var(--gold-soft);\n    letter-spacing: -.02em;\n  }\n  .topic-rule{\n    width: 40px; height: 1px; background: var(--gold)